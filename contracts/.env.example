# Copy to .env and fill in — .env itself is gitignored, never commit it.
#
# A raw testnet-only private key. Never a seed phrase. This key must never
# have touched real funds and must be burned (never reused) if it ever does.
PRIVATE_KEY=

# Base Sepolia's public RPC endpoint. No API key needed for this one — if you
# swap in a provider URL (Alchemy/Infura/etc.) that embeds a key, that whole
# URL becomes a secret and belongs in .env the same way PRIVATE_KEY does.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: override the dispute window for testing (seconds). Defaults to
# 1800 (30 minutes) if unset — see Deploy.s.sol.
# WINDOW_SECONDS=1800
